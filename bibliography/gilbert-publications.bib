 @article{Son_Gilbert_Sitti_2020, title={Magnetically Actuated Soft Capsule Endoscope for Fine-Needle Biopsy}, volume={7}, ISSN={2169-5172, 2169-5180}, DOI={10.1089/soro.2018.0171}, abstractNote={Wireless capsule endoscopes have revolutionized diagnostic procedures in the gastrointestinal (GI) tract by minimizing discomfort and trauma. Biopsy procedures, which are often necessary for a confirmed diagnosis of an illness, have been incorporated recently into robotic capsule endoscopes to improve their diagnostic functionality beyond only imaging. However, capsule robots to date have only been able to acquire biopsy samples of superficial tissues of the GI tract, which could generate false-negative diagnostic results if the diseased tissue is under the surface of the GI tract. To improve their diagnostic accuracy for submucosal tumors/diseases, we propose a magnetically actuated soft robotic capsule robot, which takes biopsy samples in a deep tissue of a stomach using the fine-needle biopsy technique. We present the design, control, and human–machine interfacing methods for the fine-needle biopsy capsule robot.
              Ex vivo
              experiments in a porcine stomach show 85% yield for the biopsy of phantom tumors located underneath the first layers of the stomach wall.}, number={1}, journal={Soft Robotics}, author={Son, Donghoon and Gilbert, Hunter and Sitti, Metin}, year={2020}, month=feb, pages={10–21}, language={en} }
