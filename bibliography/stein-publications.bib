	keywords = {ArUco, C++ languages, Computer Vision, Cranes, Gantry Crane, Inertial navigation, Input Shaper, Measurement units, Real-time systems, Tracking, Vibration Control, Vibrations},
	pages = {4390--4395},
}

@inproceedings{stein_robust_2024,
	title = {Robust {Optimal} {Control} of {Nonlinear} {Systems} via {Homotopy} {Shooting} {Method}},
	issn = {2378-5861},
	url = {https://ieeexplore.ieee.org/abstract/document/10644235},
	doi = {10.23919/ACC60939.2024.10644235},
	abstract = {This paper introduces an algorithm for solving robust optimal controllers for nonlinear systems using the homotopy shooting method. Robustness is ensured by penalizing the sensitivity states of the models during the transition and at the final time. In two examples, the cost is represented by the tracking error and terminal residual energy for a rest-to-rest maneuver. The proposed approach is illustrated on a double mass-spring-damper system and on a Type 1 Diabetes model where the cost function includes the integral of the tracking error. Our method can be readily extended for de-sensitization of multiple states over the whole time interval.},
	urldate = {2026-08-10},
	booktitle = {2024 {American} {Control} {Conference} ({ACC})},
	author = {Stein, Adrian and Singh, Tarunraj},
